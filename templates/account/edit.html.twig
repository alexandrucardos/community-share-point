{% extends 'base.html.twig' %}

{% block title %}Account settings{% endblock %}

{% block body %}
    <main class="auth-page">
        <div class="auth-card">
            <h1>{{ 'Account settings'|trans }}</h1>
            <p class="auth-switch">{{ 'Signed in as %email%'|trans({'%email%': email}) }}</p>

            {% if errors %}
                <div class="auth-error">
                    <ul>
                        {% for error in errors %}
                            <li>{{ error|trans }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post" action="{{ path('account_edit') }}" class="auth-form" enctype="multipart/form-data">
                {% if avatarFilename %}
                    <img class="account-avatar" src="{{ asset('images/avatars/' ~ avatarFilename) }}" alt="{{ 'Profile picture'|trans }}">
                {% endif %}

                <label for="avatar">{{ 'Profile picture'|trans }}</label>
                <input type="file" id="avatar" name="avatar" accept="image/png,image/jpeg,image/gif,image/webp">

                {% if avatarFilename %}
                    <label class="auth-checkbox">
                        <input type="checkbox" name="remove_avatar" value="1">
                        {{ 'Remove profile picture'|trans }}
                    </label>
                {% endif %}

                <label for="contactInfo">{{ 'Contact info'|trans }}</label>
                <input type="text" id="contactInfo" name="contactInfo" value="{{ contactInfo }}" placeholder="{{ 'Phone number or address'|trans }}">

                <hr>

                <label for="new_password">{{ 'New password'|trans }}</label>
                <input type="password" id="new_password" name="new_password" minlength="8" placeholder="{{ 'Leave blank to keep current password'|trans }}">

                <label for="new_password_confirmation">{{ 'Confirm new password'|trans }}</label>
                <input type="password" id="new_password_confirmation" name="new_password_confirmation" minlength="8">

                <label for="current_password">{{ 'Current password'|trans }}</label>
                <input type="password" id="current_password" name="current_password" required placeholder="{{ 'Required to save changes'|trans }}">

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_update') }}">

                <button type="submit">{{ 'Save changes'|trans }}</button>
            </form>
        </div>
    </main>
{% endblock %}
