{% extends 'base.html.twig' %}

{% block title %}My Items{% endblock %}

{% block body %}
    <main class="items-page">
        <div class="items-page__header">
            <h1>{{ 'My Items'|trans }}</h1>
            <a class="button" href="{{ path('household_items_new') }}">{{ 'Add item'|trans }}</a>
        </div>

        {% if items is empty %}
            <p class="items-empty">{{ "You haven't added any items yet."|trans }} <a href="{{ path('household_items_new') }}">{{ 'Add your first item'|trans }}</a>.</p>
        {% else %}
            <div class="items-grid">
                {% for item in items %}
                    <article class="item-card">
                        <img class="item-card__image" src="{{ item.imageUrl }}" alt="{{ item.name }}">

                        <div class="item-card__body">
                            <div class="item-card__header">
                                <h2 class="item-card__name">{{ item.name }}</h2>
                                <span class="item-card__status item-card__status--{{ item.status|lower|replace({' ': '-'}) }}">
                                    {{ item.status|trans }}
                                </span>
                            </div>

                            <p class="item-card__description">{{ item.description }}</p>

                            <a class="item-card__edit" href="{{ path('household_items_edit', {id: item.id}) }}">{{ 'Edit'|trans }}</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </main>
{% endblock %}
