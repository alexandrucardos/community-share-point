{% extends 'base.html.twig' %}

{% block title %}{{ (isEdit ? 'Edit item' : 'Add item')|trans }}{% endblock %}

{% block body %}
    <main class="auth-page">
        <div class="auth-card">
            <h1>{{ (isEdit ? 'Edit item' : 'Add item')|trans }}</h1>

            {% if errors %}
                <div class="auth-error">
                    <ul>
                        {% for error in errors %}
                            <li>{{ error|trans }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post" action="{{ formAction }}" class="auth-form" enctype="multipart/form-data" id="item-form">
                <img id="image-preview" class="item-form-image"{% if currentImageUrl %} src="{{ currentImageUrl }}"{% else %} hidden{% endif %} alt="{{ 'Photo'|trans }}">

                <input class="photo-picker__input" type="file" id="image" name="image" accept="image/png,image/jpeg,image/gif,image/webp" capture="environment" hidden>
                <label class="photo-picker" for="image" aria-label="{{ 'Photo'|trans }}">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 4h-4L8.5 6H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3.5L14 4Z" />
                        <circle cx="12" cy="13" r="3.5" />
                    </svg>
                </label>

                <label for="name">{{ 'Name'|trans }}</label>
                <input type="text" id="name" name="name" value="{{ name }}" required autofocus>

                <label for="description">{{ 'Description'|trans }}</label>
                <textarea id="description" name="description" rows="4" required>{{ description }}</textarea>

                <label for="status">{{ 'Status'|trans }}</label>
                <select id="status" name="status">
                    {% for itemStatus in statuses %}
                        <option value="{{ itemStatus.value }}"{{ itemStatus.value == status ? ' selected' : '' }}>{{ itemStatus.value|trans }}</option>
                    {% endfor %}
                </select>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('item_form') }}">

                {% if not isEdit %}
                    <button type="submit">{{ 'Add item'|trans }}</button>
                {% endif %}
            </form>

            {% if isEdit %}
                <div class="item-form__actions">
                    <button type="submit" form="item-form" class="item-form__save">{{ 'Save changes'|trans }}</button>
                    <form method="post" action="{{ deleteAction }}" class="item-form__delete-form" onsubmit="return confirm('{{ 'Are you sure you want to delete this item?'|trans|e('js') }}');">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_item_' ~ itemId) }}">
                        <button type="submit" class="item-card__delete">{{ 'Delete'|trans }}</button>
                    </form>
                </div>
            {% endif %}

            <p class="auth-switch"><a href="{{ path('household_items_index') }}">{{ 'Back to My Items'|trans }}</a></p>
        </div>
    </main>
{% endblock %}
