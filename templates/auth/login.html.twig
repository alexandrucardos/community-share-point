{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <main class="auth-page">
        <div class="auth-card">
            <h1>{{ 'Log in'|trans }}</h1>

            {% if error %}
                <div class="auth-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="auth-form">
                <label for="username">{{ 'Email'|trans }}</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>

                <label for="password">{{ 'Password'|trans }}</label>
                <input type="password" id="password" name="_password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit">{{ 'Log in'|trans }}</button>
            </form>

            <p class="auth-switch">{{ 'No account yet?'|trans }} <a href="{{ path('app_register') }}">{{ 'Sign up'|trans }}</a></p>
        </div>
    </main>
{% endblock %}
