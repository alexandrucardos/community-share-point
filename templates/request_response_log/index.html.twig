{% extends 'base.html.twig' %}

{% block title %}Request Log{% endblock %}

{% block body %}
    <main class="request-log">
        <div class="request-log__header">
            <h1>{{ 'Request / Response Log'|trans }}</h1>
            <p>
                {{ '%total% entries'|trans({'%total%': pagination.getTotalItemCount}) }}
                {% if not filter.isEmpty() %}<span class="request-log__filtered">{{ 'filtered'|trans }}</span>{% endif %}
            </p>
        </div>

        <form method="get" action="{{ path('request_response_log') }}" class="request-log__filters">
            <div class="request-log__filters-grid">
                <label>
                    <span>{{ 'Type'|trans }}</span>
                    <select name="type">
                        <option value="">{{ 'Any'|trans }}</option>
                        {% for type in types %}
                            <option value="{{ type }}"{{ filter.type == type ? ' selected' : '' }}>{{ type|trans }}</option>
                        {% endfor %}
                    </select>
                </label>

                <label>
                    <span>{{ 'Method'|trans }}</span>
                    <select name="method">
                        <option value="">{{ 'Any'|trans }}</option>
                        {% for httpMethod in ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'] %}
                            <option value="{{ httpMethod }}"{{ filter.method == httpMethod ? ' selected' : '' }}>{{ httpMethod }}</option>
                        {% endfor %}
                    </select>
                </label>

                <label>
                    <span>{{ 'Route'|trans }}</span>
                    <input type="text" name="route" value="{{ filter.route ?? '' }}" placeholder="app_login">
                </label>

                <label>
                    <span>{{ 'Status'|trans }}</span>
                    <input type="number" name="status" value="{{ filter.status ?? '' }}" min="100" max="599" placeholder="404">
                </label>

                <label class="request-log__filters-search">
                    <span>{{ 'Search'|trans }}</span>
                    <input type="search" name="search" value="{{ filter.search ?? '' }}" placeholder="{{ 'URI or payload value'|trans }}">
                </label>
            </div>

            <div class="request-log__filters-actions">
                <button type="submit" class="button">{{ 'Filter'|trans }}</button>
                <a href="{{ path('request_response_log') }}" class="request-log__filters-reset">{{ 'Reset'|trans }}</a>
            </div>
        </form>

        {% if pagination is empty %}
            <div class="request-log__empty">
                <span class="request-log__empty-icon" aria-hidden="true">🗒️</span>
                <p>{{ 'No log entries match the current filters.'|trans }}</p>
            </div>
        {% else %}
            <div class="request-log__table-wrap">
                <table class="request-log__table">
                    <thead>
                        <tr>
                            <th>{{ 'Time'|trans }}</th>
                            <th>{{ 'Type'|trans }}</th>
                            <th>{{ 'Method'|trans }}</th>
                            <th>{{ 'URI'|trans }}</th>
                            <th>{{ 'Status'|trans }}</th>
                            <th>{{ 'Duration'|trans }}</th>
                            <th>{{ 'Payload'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in pagination %}
                            <tr class="request-log__row request-log__row--{{ entry.type }}">
                                <td class="request-log__time">{{ entry.timestamp|date('d M H:i:s') }}</td>
                                <td>
                                    <span class="request-log__type request-log__type--{{ entry.type }}">{{ entry.type }}</span>
                                </td>
                                <td>
                                    {% if entry.method %}
                                        <span class="request-log__method request-log__method--{{ entry.method|lower }}">{{ entry.method }}</span>
                                    {% else %}—{% endif %}
                                </td>
                                <td class="request-log__uri-cell">
                                    <span class="request-log__uri">{{ entry.uri }}</span>
                                    {% if entry.route %}<span class="request-log__route">{{ entry.route }}</span>{% endif %}
                                </td>
                                <td>
                                    {% if entry.status is not null %}
                                        <span class="request-log__status request-log__status--{{ entry.status >= 500 ? 'server-error' : (entry.status >= 400 ? 'error' : (entry.status >= 300 ? 'redirect' : 'ok')) }}">{{ entry.status }}</span>
                                    {% else %}—{% endif %}
                                    {% if entry.contentType %}<div class="request-log__content-type">{{ entry.contentType }}</div>{% endif %}
                                </td>
                                <td>
                                    {% if entry.durationMs is not null %}
                                        <span class="request-log__duration{{ entry.durationMs > 1000 ? ' request-log__duration--slow' : (entry.durationMs > 300 ? ' request-log__duration--warn' : '') }}">{{ entry.durationMs }} ms</span>
                                    {% else %}—{% endif %}
                                </td>
                                <td>
                                    {% if entry.type == 'request' %}
                                        <details class="request-log__payload">
                                            <summary>{{ entry.payload|length }} field(s)</summary>
                                            <pre>{{ entry.payload|json_encode(128 b-or 64) }}</pre>
                                        </details>
                                    {% else %}—{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <nav class="request-log__pagination">
                {{ knp_pagination_render(pagination) }}
            </nav>
        {% endif %}
    </main>
{% endblock %}
